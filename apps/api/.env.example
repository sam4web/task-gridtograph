# --- Server Configuration ---
PORT=3001
NODE_ENV=development
# comma-separated list for CORS (e.g., http://localhost:3000,https://yourdomain.com)
ALLOWED_ORIGINS=http://localhost:3000

# --- Authentication Secrets ---
# Generate these using: `require('crypto').randomBytes(124).toString('base64')`
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key

# --- Token Expiry Settings ---
# Use string formats recognized by 'ms' or 'jsonwebtoken' (e.g., 15m, 7d)
ACCESS_TOKEN_EXPIRY_TIME=15m
REFRESH_TOKEN_EXPIRY_TIME=7d

# --- Database Connection Strings ---
# PostgreSQL (Drizzle)
DATABASE_URL=postgresql://user:password@localhost:5432/your_db_name
# MongoDB (Mongoose)
MONGODB_URL=mongodb://localhost:27017/your_mongo_db_name

# --- SMTP / Email Service (OTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
